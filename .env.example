DB_TARGET=MSSQL
MSSQL_TARGET=azure
MSSQL_AZURE_SERVER=
MSSQL_AZURE_PORT=1433
MSSQL_AZURE_DATABASE=
MSSQL_AZURE_USER=
MSSQL_AZURE_PASSWORD=
MSSQL_AZURE_ENCRYPT=true
MSSQL_AZURE_TRUST_SERVER_CERTIFICATE=false
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Supabase Data API. Required only when DB_TARGET=SUPABASE.
# Keep the service-role key on the backend only; never expose it to a browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_API_TIMEOUT_S=20
FRONTEND_ORIGIN=
EMPLOYEE_AUTH_SECRET=
ADMIN_PASSWORD=
SCREENING_ADMIN_PASSWORD=
SUPERVISOR_PASSWORD=
FACE_MATCH_SERVICE_URL=
FACE_MATCH_API_KEY=
LOCAL_LLM_URL=
LOCAL_LLM_API_KEY=
UPLOAD_DIR=uploads
