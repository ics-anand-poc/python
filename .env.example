# Copy to .env.local and fill in. See docs/ARCHITECTURE.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel this must be a public API. http://127.0.0.1:8000 is only for local dev.
BACKEND_URL=http://127.0.0.1:8000
# Supabase talentscope project (ap-northeast-2). Vercel can reach this. It cannot reach 10.0.1.7.
NEXT_PUBLIC_SUPABASE_URL=https://cwinquyprbjctedotchp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MSSQL_TARGET=local
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_LOCAL_SERVER=localhost
MSSQL_LOCAL_PORT=1433
MSSQL_LOCAL_DATABASE=Talentscope
MSSQL_LOCAL_USER=
MSSQL_LOCAL_PASSWORD=
MSSQL_LOCAL_ENCRYPT=true
MSSQL_LOCAL_TRUST_SERVER_CERTIFICATE=true
# Company SQL Server ICSBETLMS01. Dev: TalentScope_DB_Dev. Prod: TalentScope_DB_Live.
MSSQL_REMOTE_SERVER=10.0.1.7
MSSQL_REMOTE_PORT=1433
MSSQL_REMOTE_DATABASE=TalentScope_DB_Dev
MSSQL_REMOTE_USER=TalentScopeAdmin
MSSQL_REMOTE_PASSWORD=
MSSQL_REMOTE_ENCRYPT=true
MSSQL_REMOTE_TRUST_SERVER_CERTIFICATE=true
MSSQL_AZURE_SERVER=
MSSQL_AZURE_PORT=1433
MSSQL_AZURE_DATABASE=
MSSQL_AZURE_USER=
MSSQL_AZURE_PASSWORD=
EMPLOYEE_AUTH_SECRET=
ADMIN_PASSWORD=
SCREENING_ADMIN_PASSWORD=
SUPERVISOR_PASSWORD=
# Company mail relay (no password). On Azure app VM use SMTP_HOST=192.168.0.131 —
# webmail.infinite.com resolves to a public IP there and port 25 times out.
# Optional portal deadline copy: PRODUCT_ASSESSMENT_DEADLINE=31st Oct 26
SMTP_HOST=192.168.0.131
SMTP_PORT=25
SMTP_USE_SSL=0
SMTP_STARTTLS=0
SMTP_SSL_VERIFY=0
SMTP_USER=TalentScope@infinite.com
SMTP_PASS=
SMTP_FROM=TalentScope <TalentScope@infinite.com>
LOCAL_LLM_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=Qwen3.5-4B-Q4_K_M
LOCAL_LLM_API_KEY=
FACE_MATCH_SERVICE_URL=http://127.0.0.1:10000
FACE_MATCH_API_KEY=
# local keeps uploads on disk. mssql stores them in dbo.storage_objects (migration 006).
STORAGE_PROVIDER=local
IDENTITY_MIN_CONFIDENCE=70
MICROSOFT_TENANT_ID=
SAML_ISSUER=
SAML_IDP_CERT=
SAML_IDP_METADATA_URL=
# SAML_IDP_CERT accepts several certificates separated by | (use two during certificate rotation)
SAML_ENABLED=1
SAML_IDP_ENTITY_ID=
SAML_ADMIN_SSO=1
SAML_ALLOW_IDP_INITIATED=0
SAML_FORCE_AUTHN=0
# REDIS_URL=redis://127.0.0.1:6379/0
QGEN_WORKERS=2
QGEN_MAX_ATTEMPTS=3
QGEN_BACKOFF_S=20
QGEN_START_WAIT_S=20
