# Copy to .env (never commit .env).

# Which DB the scripts talk to when --target is not passed: local | remote
MSSQL_TARGET=local

# Local SQL Server in Docker (npm run db:up)
MSSQL_SA_PASSWORD=
MSSQL_LOCAL_SERVER=127.0.0.1
MSSQL_LOCAL_PORT=1433
MSSQL_LOCAL_DATABASE=TalentScope
MSSQL_LOCAL_USER=sa
MSSQL_LOCAL_PASSWORD=
MSSQL_LOCAL_ENCRYPT=true
MSSQL_LOCAL_TRUST_SERVER_CERTIFICATE=true

# Company SQL Server
MSSQL_REMOTE_SERVER=
MSSQL_REMOTE_PORT=1433
MSSQL_REMOTE_DATABASE=InterviewApp_Dev
MSSQL_REMOTE_USER=
MSSQL_REMOTE_PASSWORD=
MSSQL_REMOTE_ENCRYPT=true
MSSQL_REMOTE_TRUST_SERVER_CERTIFICATE=true

# Azure SQL
MSSQL_AZURE_SERVER=
MSSQL_AZURE_PORT=1433
MSSQL_AZURE_DATABASE=
MSSQL_AZURE_USER=
MSSQL_AZURE_PASSWORD=
MSSQL_AZURE_ENCRYPT=true
MSSQL_AZURE_TRUST_SERVER_CERTIFICATE=false

# Supabase (source for npm run db:pull)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
