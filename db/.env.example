# Copy to .env (never commit .env).

# Which DB the scripts talk to when --target is not passed: local | remote
MSSQL_TARGET=local

# Local SQL Server in Docker (npm run db:up)
MSSQL_SA_PASSWORD=TalentScope_Local_Dev1!
MSSQL_LOCAL_SERVER=127.0.0.1
MSSQL_LOCAL_PORT=1433
MSSQL_LOCAL_DATABASE=TalentScope
MSSQL_LOCAL_USER=sa
MSSQL_LOCAL_PASSWORD=TalentScope_Local_Dev1!
MSSQL_LOCAL_ENCRYPT=true
MSSQL_LOCAL_TRUST_SERVER_CERTIFICATE=true

# Company SQL Server ICSBETLMS01. Dev: TalentScope_DB_Dev. Prod: TalentScope_DB_Live.
MSSQL_REMOTE_SERVER=10.0.1.7
MSSQL_REMOTE_PORT=1433
MSSQL_REMOTE_DATABASE=TalentScope_DB_Dev
MSSQL_REMOTE_USER=TalentScopeAdmin
MSSQL_REMOTE_PASSWORD=
MSSQL_REMOTE_ENCRYPT=true
MSSQL_REMOTE_TRUST_SERVER_CERTIFICATE=true

# Supabase (source for npm run db:pull)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
